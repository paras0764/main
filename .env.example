# ==============================================================================
# Google Sheets API & Service Configuration Template
# Copy this file to '.env' and fill in your actual credentials.
# Note: In Create React App, environment variables must start with 'REACT_APP_'.
# ==============================================================================

# Google Cloud API Key for Google Sheets v4 API
REACT_APP_GOOGLE_API_KEY=your_google_sheets_api_key_here

# ------------------------------------------------------------------------------
# Google Sheet Spreadsheet IDs
# ------------------------------------------------------------------------------
REACT_APP_SHEET_ID_RGP_NEW=your_rgp_new_sheet_id_here
REACT_APP_SHEET_ID_RGP_OLD=your_rgp_old_sheet_id_here
REACT_APP_SHEET_ID_CUTTING=your_cutting_sheet_id_here
REACT_APP_SHEET_ID_DORI=your_dori_sheet_id_here
REACT_APP_SHEET_ID_ZIP_RGP=your_zip_rgp_sheet_id_here
REACT_APP_SHEET_ID_PURCHASE_ORDER=your_purchase_order_sheet_id_here

# ------------------------------------------------------------------------------
# Google Apps Script Web App Deployment URLs (/exec)
# ------------------------------------------------------------------------------
REACT_APP_WEB_APP_URL_RGP=https://script.google.com/macros/s/your_rgp_script_id/exec
REACT_APP_WEB_APP_URL_DORI=https://script.google.com/macros/s/your_dori_script_id/exec
REACT_APP_WEB_APP_URL_LEGACY_RGP=https://script.google.com/macros/s/your_legacy_rgp_script_id/exec
REACT_APP_WEB_APP_URL_PO_ASPER_SHADE=https://script.google.com/macros/s/your_po_shade_script_id/exec
REACT_APP_WEB_APP_URL_PO_DASHBOARD=https://script.google.com/macros/s/your_po_dash_script_id/exec
REACT_APP_WEB_APP_URL_PO_LOT=https://script.google.com/macros/s/your_po_lot_script_id/exec
REACT_APP_WEB_APP_URL_PO_TRACKING=https://script.google.com/macros/s/your_po_tracking_script_id/exec
REACT_APP_WEB_APP_URL_ZIP=https://script.google.com/macros/s/your_zip_script_id/exec
REACT_APP_WEB_APP_URL_ZIP_APPROVAL=https://script.google.com/macros/s/your_zip_approval_script_id/exec
REACT_APP_WEB_APP_URL_PO_SUMMARY_GATE_RECEIVE=https://script.google.com/macros/s/your_gate_receive_script_id/exec
